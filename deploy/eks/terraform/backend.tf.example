# Optional remote state on AWS S3 with a DynamoDB lock table.
#
# Chicken-and-egg: the bucket + lock table must exist before Terraform can store
# state in them. Create them once (console/CLI), then rename this file to
# backend.tf and run:  terraform init -migrate-state
#
#   aws s3api create-bucket --bucket aisat-intel-tfstate --region ap-southeast-1 \
#     --create-bucket-configuration LocationConstraint=ap-southeast-1
#   aws s3api put-bucket-versioning --bucket aisat-intel-tfstate \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name aisat-intel-tflock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST --region ap-southeast-1
#
# State contains secrets (e.g. resource metadata) — keep the bucket private,
# encrypted, and never commit *.tfstate.
#
# terraform {
#   backend "s3" {
#     bucket         = "aisat-intel-tfstate"
#     key            = "eks/prod/terraform.tfstate"
#     region         = "ap-southeast-1"
#     dynamodb_table = "aisat-intel-tflock"
#     encrypt        = true
#   }
# }
