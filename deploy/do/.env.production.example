# ---------------------------------------------------------------------------
# Production environment for the droplet. COPY to `.env.production` on the droplet
# and fill in real values. NEVER commit `.env.production` (it is gitignored).
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Generate strong secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Edge / TLS (Caddy) -----------------------------------------------------
PRODUCTION_HOST=example.com            # DNS A-record must point at this droplet
ACME_EMAIL=you@example.com             # Let's Encrypt account / expiry notices

# --- Image coordinates (usually exported by deploy.sh; safe defaults here) ---
REGISTRY=docker.io
IMAGE_PREFIX=aisat
# DOCKERHUB_USERNAME and IMAGE_TAG are injected by the CD pipeline at deploy time.
DOCKERHUB_USERNAME=your-dockerhub-username

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=aisat
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=aisat
DATABASE_URL=postgres://aisat:change-me-strong@postgres:5432/aisat?sslmode=disable

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- NATS (JetStream) -------------------------------------------------------
NATS_URL=nats://nats:4222

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://qdrant:6333

# --- Object storage (MinIO / S3) --------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-strong
S3_BUCKET=aisat
S3_REGION=us-east-1

# --- LLM gateway (LiteLLM) --------------------------------------------------
LLM_GATEWAY_URL=http://llm-gateway:4000
LLM_GATEWAY_KIND=litellm
LLM_GATEWAY_MASTER_KEY=sk-change-me-strong   # app tiers auth to the gateway with this
# Provider keys — consumed ONLY by the gateway service:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Sandbox tier (isolated exec: crawl4ai, MarkItDown convert, code-gen) ----
# SANDBOX_KIND selects the isolation backend behind the Sandbox port. The security
# contract (no ambient creds, default-deny egress, hard caps, metered, audited) is
# identical across all of them — only escape-resistance differs:
#   service       — LONG-LIVED pools reached over HTTP. THE DO DEFAULT. Creates
#                   nothing at runtime, so NO RUNTIME SOCKET IS NEEDED ANYWHERE.
#   docker        — sibling container per job. Needs the socket -> local dev only.
#   k8s_pod       — hardened pod via an RBAC-scoped ServiceAccount. The EKS default
#                   and the preferred posture; needs a cluster (k3s counts).
#   e2b_selfhost  — Firecracker microVM. Needs /dev/kvm, so a KVM-capable or
#                   bare-metal host — a standard droplet CANNOT run this.
#   e2b_cloud     — managed microVM, usage-billed; user files leave your infra.
#
# SOCKET WARNING (contract invariant 8) — applies to SANDBOX_KIND=docker, which is
# why the DO default is `service` instead. SANDBOX_KIND=docker needs a container
# runtime socket, and that socket is HOST-EQUIVALENT PRIVILEGE: whoever reaches it
# can create a privileged container with / bind-mounted. Mounting it :ro does NOT
# help — read-only applies to the socket file, not to the API. So:
#   - mount it into the SANDBOX EXECUTOR ONLY. Never into api/relay/worker/
#     llm-gateway/mcp — the services handling untrusted input and model output are
#     the worst possible holders of a root-equivalent handle.
#   - rootless Docker is NOT a fix here: gVisor does not run cleanly under rootless
#     Docker, so you cannot combine the two. The mitigation is PLACEMENT (confine or
#     split hosts), not rootlessness.
#   - prefer k8s_pod (k3s on the droplet) if you want this class of risk gone: pod
#     creation via RBAC ServiceAccount is strictly less privilege than a socket.
# See deploy/sandbox/README.md and contracts/sandbox-runtime.md.
SANDBOX_URL=http://sandbox-orchestrator:49983
SANDBOX_KIND=service

# SANDBOX_RUNTIME is a SEPARATE, ORTHOGONAL axis: it picks the isolation runtime,
# not the orchestrator. gVisor is NOT a different backend — it is one flag on the
# backend you already run (--runtime=runsc here; runtimeClassName: gvisor on k8s).
#   runc  — default. Namespaces + cgroups + seccomp; shared kernel.
#   runsc — gVisor. A real syscall boundary. Needs Linux + runsc installed on the
#           host, so it works on THIS droplet but NOT on a macOS laptop.
# Per-template overrides are what let tmpl-convert (untrusted user files, the
# higher-risk surface) run on gVisor while tmpl-crawl stays on runc — Chromium is
# gVisor's worst case. Taking runsc for convert here costs nothing.
SANDBOX_RUNTIME=runc
SANDBOX_RUNTIME_TMPL_CONVERT=runsc
SANDBOX_API_KEY=change-me-strong

# --- Auth (Casdoor) ---------------------------------------------------------
CASDOOR_ENDPOINT=https://auth.example.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG=aisat
CASDOOR_APP=aisat
JWT_SECRET=change-me-strong

# --- Bot protection ---------------------------------------------------------
TURNSTILE_SECRET=

# --- Observability ----------------------------------------------------------
# Traces -> Tempo (only meaningful when the monitoring overlay is running).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
SENTRY_DSN=

# LLM tracing -> Langfuse. Langfuse runs in the BASE stack (it's an app
# dependency), so these are always required. HOST is the in-network service; the
# PUBLIC/SECRET keys are created in the Langfuse UI on first login (or pre-seeded
# via the LANGFUSE_INIT_* block in docker-compose.prod.yml). The remaining three
# are Langfuse's own Postgres + session secrets — generate with `openssl rand -hex 32`.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DB_PASSWORD=change-me-strong
LANGFUSE_NEXTAUTH_SECRET=change-me-strong
LANGFUSE_SALT=change-me-strong
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# --- Monitoring overlay (deploy/do/monitoring — only if ENABLE_MONITORING=true) ---
# Grafana admin login (UI bound to 127.0.0.1:3000; reach via SSH tunnel).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong
GRAFANA_ROOT_URL=http://localhost:3000

# --- Runtime ----------------------------------------------------------------
ENV=production
LOG_LEVEL=info
