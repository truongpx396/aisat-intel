# ---------------------------------------------------------------------------
# Local dev overrides for deploy/docker-compose.yml (T005).
#
# OPTIONAL: docker-compose.yml already has working dev fallbacks baked in
# (`${VAR:-dev-default}` for every credential-shaped value), so `make up` /
# `docker compose -f deploy/docker-compose.yml up -d` works with NO .env file
# at all. Copy this file only if you want to override a default:
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored (repo root .gitignore's blanket `.env` rule) —
# never commit it. Every value below is a placeholder, clearly NOT suitable
# for anything beyond a throwaway local stack. The production equivalent
# lives at deploy/do/.env.production.example (a DIFFERENT file, different
# stack — do not confuse the two).
# ---------------------------------------------------------------------------

# --- PostgreSQL (also backs Casdoor's dataSourceName in this compose file) --
POSTGRES_USER=aisat
POSTGRES_PASSWORD=dev-only-postgres-pw
POSTGRES_DB=aisat

# --- Object storage (MinIO / S3-compatible) ---------------------------------
MINIO_ROOT_USER=dev-minio-admin
MINIO_ROOT_PASSWORD=dev-minio-password
