# Optional remote state on DigitalOcean Spaces (S3-compatible).
#
# Chicken-and-egg: the state bucket must exist before you can store state in it.
# Create it once (DO console, or `enable_spaces = true` with a separate bucket),
# then rename this file to backend.tf and run:  terraform init -migrate-state
#
# Auth for the backend uses the S3 env vars (your Spaces keys):
#   export AWS_ACCESS_KEY_ID=<spaces_access_id>
#   export AWS_SECRET_ACCESS_KEY=<spaces_secret_key>
#
# terraform {
#   backend "s3" {
#     endpoints                   = { s3 = "https://sgp1.digitaloceanspaces.com" }
#     bucket                      = "aisat-intel-tfstate"
#     key                         = "prod/terraform.tfstate"
#     region                      = "us-east-1" # dummy value; required by the S3 backend
#     skip_credentials_validation = true
#     skip_metadata_api_check     = true
#     skip_region_validation      = true
#     skip_requesting_account_id  = true
#     skip_s3_checksum            = true
#   }
# }
