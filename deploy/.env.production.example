# ---------------------------------------------------------------------------
# Production environment for the droplet. COPY to `.env.production` on the droplet
# and fill in real values. NEVER commit `.env.production` (it is gitignored).
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Generate strong secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Edge / TLS (Caddy) -----------------------------------------------------
PRODUCTION_HOST=example.com            # DNS A-record must point at this droplet
ACME_EMAIL=you@example.com             # Let's Encrypt account / expiry notices

# --- Image coordinates (usually exported by deploy.sh; safe defaults here) ---
REGISTRY=docker.io
IMAGE_PREFIX=aisat
# DOCKERHUB_USERNAME and IMAGE_TAG are injected by the CD pipeline at deploy time.
DOCKERHUB_USERNAME=your-dockerhub-username

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=aisat
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=aisat
DATABASE_URL=postgres://aisat:change-me-strong@postgres:5432/aisat?sslmode=disable

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- NATS (JetStream) -------------------------------------------------------
NATS_URL=nats://nats:4222

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://qdrant:6333

# --- Object storage (MinIO / S3) --------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-strong
S3_BUCKET=aisat
S3_REGION=us-east-1

# --- LLM gateway (LiteLLM) --------------------------------------------------
LLM_GATEWAY_URL=http://llm-gateway:4000
LLM_GATEWAY_KIND=litellm
LLM_GATEWAY_MASTER_KEY=sk-change-me-strong   # app tiers auth to the gateway with this
# Provider keys — consumed ONLY by the gateway service:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Auth (Casdoor) ---------------------------------------------------------
CASDOOR_ENDPOINT=https://auth.example.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG=aisat
CASDOOR_APP=aisat
JWT_SECRET=change-me-strong

# --- Bot protection ---------------------------------------------------------
TURNSTILE_SECRET=

# --- Observability ----------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Runtime ----------------------------------------------------------------
ENV=production
LOG_LEVEL=info
